DB_ADAPTER=sequelize
DATABASE_URL=postgresql://ska_app:YOUR_PASSWORD@127.0.0.1:5432/ska_organizer
PORT=3001
NODE_ENV=development

# A separate database used only by npm run test:postgres.
TEST_DATABASE_URL=postgresql://ska_app:YOUR_PASSWORD@127.0.0.1:5432/ska_organizer_test

# Exact frontend addresses allowed to sign in (no trailing slash).
# For Windows Chrome, add the Ubuntu VM Network URL printed by Vite.
# Frontend and API must use the same hostname/IP and scheme; ports may differ.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In production, use HTTPS for both frontend and API and NODE_ENV=production.
