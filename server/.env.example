DB_ADAPTER=sequelize
DATABASE_URL=postgresql://ska_app:YOUR_PASSWORD@127.0.0.1:5432/ska_organizer
PORT=3001
# Native HTTPS service sets this to 127.0.0.1. Leave unset for Docker/development.
# BIND_HOST=127.0.0.1
NODE_ENV=development
FACILITY_TIME_ZONE=America/Los_Angeles

# A separate database used only by npm run test:postgres.
TEST_DATABASE_URL=postgresql://ska_app:YOUR_PASSWORD@127.0.0.1:5432/ska_organizer_test

# Exact frontend addresses allowed to sign in (no trailing slash).
# For Windows Chrome, add the Ubuntu VM Network URL printed by Vite.
# Frontend and API must use the same hostname/IP and scheme; ports may differ.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In production, use HTTPS for both frontend and API and NODE_ENV=production.

# Optional remembered sign-in limits (whole days, 1–90; idle cannot exceed total).
# Unchecked sign-ins keep the existing 8-hour total / 30-minute idle limits.
REMEMBER_SESSION_ABSOLUTE_DAYS=30
REMEMBER_SESSION_IDLE_DAYS=7

# Optional local activity AI. Leave MODEL unset to keep AI disabled.
# Use an already installed local model; no cloud models or automatic downloads.
# Start the separate Ollama runtime with OLLAMA_NO_CLOUD=1 and
# OLLAMA_HOST=127.0.0.1:11434. The app never configures or starts Ollama.
# SKAO_AI_MODEL=YOUR_INSTALLED_LOCAL_MODEL
# SKAO_AI_URL=http://127.0.0.1:11434
# SKAO_AI_TIMEOUT_MS=120000
# TIMEOUT_MS accepts 1000-300000; one generation runs at a time.
# Optional reviewed education/policy excerpts; see docs/local-activity-ai.md.
# Native service uses ProtectHome: keep this outside the repo and home folders.
# SKAO_AI_SOURCES_FILE=/etc/skao/ai/references.json
# Run from the repository root: bash SKAO.sh ai-check

# Optional separate private LAN AI host (HTTPS with valid IP certificate):
# SKAO_AI_LAN=1
# SKAO_AI_URL=https://192.168.1.50:8443
# SKAO_AI_TOKEN=GENERATE_A_DEDICATED_RANDOM_32_PLUS_CHARACTER_TOKEN
# SKAO_AI_CA_FILE=/etc/skao/ai/ca.pem
